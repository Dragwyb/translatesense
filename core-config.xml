    </gutenberg-block>

    <gutenberg-block type="core/gallery" translate="1">
        <xpath>//figure/figcaption</xpath>
        <xpath>//figure/img/@alt</xpath>
    </gutenberg-block>

    <gutenberg-block type="core/audio" translate="1">

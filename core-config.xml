<?xml version="1.0" encoding="UTF-8"?>
<wpml-config>
    <!-- Gutenberg Block Mapping -->
    <gutenberg-blocks>
        <gutenberg-block type="core/paragraph" translate="1">
            <key name="content" />
            <xpath>//p</xpath>
        </gutenberg-block>

        <gutenberg-block type="core/image" translate="1">
            <key name="alt" />
            <key name="caption" />
            <xpath>//figure/figcaption</xpath>
            <xpath>//figure//img/@alt</xpath>
            <xpath>//figure//img/@title</xpath>
            <xpath type="link">//figure/a/@href</xpath>
        </gutenberg-block>

    <gutenberg-block type="core/heading" translate="1">
        <key name="content" />
        <xpath>//*[self::h1 or self::h2 or self::h3 or self::h4 or self::h5 or self::h6]</xpath>
    </gutenberg-block>

    <gutenberg-block type="core/list" translate="1">
        <xpath>//ul/li|//ol/li</xpath>
    </gutenberg-block>

    <gutenberg-block type="core/list-item" translate="1">
        <key name="content" />
        <xpath>//li</xpath>
    </gutenberg-block>

    <gutenberg-block type="core/quote" translate="1">
        <key name="citation" />
        <xpath>//blockquote/p</xpath>
        <xpath>//blockquote/cite</xpath>
    </gutenberg-block>

    <gutenberg-block type="core/details" translate="1">
        <key name="summary" />
        <xpath>//summary</xpath>
    </gutenberg-block>

    <gutenberg-block type="core/preformatted" translate="1">
        <key name="content" />
        <xpath>//pre</xpath>
    </gutenberg-block>

    <gutenberg-block type="core/pullquote" translate="1">
        <key name="citation" />
        <key name="value" />
        <xpath>//blockquote/p</xpath>
        <xpath>//blockquote/cite</xpath>
    </gutenberg-block>

    <gutenberg-block type="core/table" translate="1">
        <key name="caption" />
        <key name="body">
            <key name="cells">
                <key name="content" />
            </key>
        </key>
        <key name="head">
            <key name="cells">
                <key name="content" />
            </key>
        </key>
        <key name="foot">
            <key name="cells">
                <key name="content" />
            </key>
        </key>
        <xpath>//th</xpath>
        <xpath>//td</xpath>
        <xpath>//figure/figcaption</xpath>
    </gutenberg-block>

    <gutenberg-block type="core/verse" translate="1">
        <key name="content" />
        <xpath>//pre</xpath>
    </gutenberg-block>

    <gutenberg-block type="core/freeform" translate="1">
        <key name="content" />
    </gutenberg-block>

    <gutenberg-block type="core/media-text" translate="1">
        <key name="mediaAlt" />
        <xpath>//figure/img/@alt</xpath>
    </gutenberg-block>

    <gutenberg-block type="core/button" translate="1">
        <key name="text" />
        <xpath>//a</xpath>
        <xpath type="link">//a/@href</xpath>
    </gutenberg-block>

    <gutenberg-block type="core/more" translate="1">
        <key name="customText" />
    </gutenberg-block>

    <gutenberg-block type="core/search" translate="1">
        <key name="label" />
        <key name="placeholder" />
        <key name="buttonText" />
    </gutenberg-block>

    <gutenberg-block type="core/post-terms" translate="1">
        <key name="prefix" />
        <key name="suffix" />
    </gutenberg-block>

    <gutenberg-block type="core/read-more" translate="1">
        <key name="content" />
    </gutenberg-block>

    <gutenberg-block type="core/text-columns" translate="1">
        <key name="content">
            <key name="children" />
        </key>
    </gutenberg-block>

    <gutenberg-block type="core/accordion-heading" translate="1">
        <key name="title" />
    </gutenberg-block>

    <gutenberg-block type="core/file" translate="1">
        <key name="downloadButtonText" />
        <xpath>//div/a</xpath>
    </gutenberg-block>

    <gutenberg-block type="core/icon" translate="1">
